    {
      "kind": "substitution",
      "subject": "ilma mċempil",
      "rationale": "משקע huwa l-ilma li stabax u fonda — 'settled water'; 'mċempil' iżomm it-tifsira ta' ilma ċar li ġie mistriħ."
