    {
      "kind": "wordplay",
      "subject": "מיץ ... מיץ ... מיץ",
      "rationale": "Ir-repetizzjoni ta' 'pressjoni' tliet darbiet tibni l-paralleliżmu: ħalib→ġobon, moħħ→demm, għadab→ġlied."
    },
    {
      "kind": "substitution",
      "subject": "אף \/ אפים",
      "rationale": "L-ewwel 'af huwa l-moħħ litteralment; 'appajim (dual tan-moħħ) huwa idjom għall-għadab, u għalhekk tradott b'hekk."
    },
    {
      "kind": "alternative",
      "subject": "חמאה",
      "rationale": "Ħalib imsawwat\/ġobon frisk; 'ħalib imsawwat' iżomm l-ambjent rurali aħjar."
    }
  ],
  "translation": "Għax il-pressjoni tal-ħalib toħroġ ġobon, u l-pressjoni tan-moħħ toħroġ demm, u l-pressjoni ta' l-għadab toħroġ ġlied.",
