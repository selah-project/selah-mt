    {
      "kind": "addition",
      "subject": "ma'",
      "rationale": "l-את qabel מזבחותיך jqiegħed l-artali bħala l-post fejn tqiegħed l-ġuri; 'ma'' jagħti d-direzzjoni li l-Lhudi jħalliha mgħottija."
    }
