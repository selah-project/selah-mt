  "notes": [
    {
      "kind": "hapax",
      "subject": "אפעה",
      "rationale": "Serp velenuż li jidher biss hawn (u b'rispett għall-għerq) fil-Tanakh; ''lifgħa'' żżomm il-qraba tal-ħoss."
    },
    {
      "kind": "crux",
      "subject": "משא בהמות נגב",
      "rationale": "''Tagħbija tal-bhejjem tan-Negħeb'': titolu ta' profeta kontra l-vjaġġ tal-ambaxxata lejn l-Eġittu, jew sempliċiment deskrizzjoni tal-bhejjem li jġorru."
    },
    {
      "kind": "substitution",
      "subject": "שרף מעופף",
      "rationale": "Saraf li jtir: serp jdukkien velenuż, mhux ħlejqa mistika."
    }
  ],
  "translation": "Tagħbija tal-bhejjem tan-Negħeb: f'art ta' dejjq u ta' msibba, luvja u iljun, minnha lifgħa u saraf li jtir; iġorru fuq spallhom il-ġmir il-ġid tagħhom, u fuq ġibien il-ġemlieli t-teżori tagħhom, lil nies li ma jagħtulhom xejn.",
