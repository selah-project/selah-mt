    {
      "kind": "wordplay",
      "subject": "ויכם...ויכם",
      "rationale": "L-għerq נכה jirrepeti ruħu darbtejn fil-vers (f'Gibgħon u sa Ażeka), ritmu ta' maqtugħa li jibqa' bil-Malti b''laqathom' ripetut."
    }
  ],
